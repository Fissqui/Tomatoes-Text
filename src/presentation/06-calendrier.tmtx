{"format":"frame-text","version":1,"id":"18d16dba-de1a-488c-a11e-840476d5a115","title":"Calendrier des semis","created":"2026-10-20T08:00:00.000Z","modified":"2026-10-20T08:00:00.000Z","settings":{"autoIndent":false,"titleInText":true,"columns":{"count":1,"rule":false},"index":[],"comments":[],"theme":{"v":1,"id":"carnet","name":"Carnet","note":"Nunito, titre manuscrit, rouge tomate et vert tige.","modified":false,"text":{"font":"Nunito","size":11.5,"line":1.6,"space":0.6,"align":"","indent":""},"accent":"#c8402c","styles":{"title":{"font":"Caveat","size":32,"bold":true,"italic":false,"underline":false,"caps":false,"smallcaps":false,"color":"#c8402c","align":"","rule":false,"number":""},"headings":[{"font":"Nunito","size":17,"bold":true,"italic":false,"underline":false,"caps":false,"smallcaps":false,"color":"#c8402c","align":"","rule":false,"number":""},{"font":"Nunito","size":14,"bold":true,"italic":false,"underline":false,"caps":false,"smallcaps":false,"color":"#2f7d32","align":"","rule":false,"number":""},{"font":"Nunito","size":12,"bold":true,"italic":false,"underline":false,"caps":false,"smallcaps":false,"color":"","align":"","rule":false,"number":""},{"font":"Nunito","size":12,"bold":false,"italic":true,"underline":false,"caps":false,"smallcaps":false,"color":"","align":"","rule":false,"number":""},{"font":"Nunito","size":11,"bold":false,"italic":false,"underline":false,"caps":true,"smallcaps":false,"color":"","align":"","rule":false,"number":""}],"bullets":[{"symbol":"•","color":"#c8402c"},{"symbol":"◦","color":""},{"symbol":"▪","color":""},{"symbol":"–","color":""},{"symbol":"–","color":""}]},"table":{"style":"raye","color":"theme","header":true,"first":false,"total":false,"last":false,"bands":true,"bandcols":false,"sep":false,"font":"","size":0,"pad":""},"callout":{"look":"fond","color":""},"quote":{"look":"fond","color":""},"toc":{"title":"Plan","showTitle":true,"titleStyle":"petites-capitales","titleAlign":"gauche","docTitle":false,"levels":2,"font":"","size":10,"color":"","frame":"cadre","number":"titres","leaders":true,"indent":true,"preset":"compact"},"diagram":{"fill":"#fde2e1","stroke":"#e74c3c","textColor":"#78281f","link":"#c0392b","font":"Segoe UI","strokeWidth":1.5,"shadow":false,"palette":false},"margins":null},"mode":"note","pages":{"size":"A4","w":210,"h":297,"orient":"portrait","turned":{},"margins":{"top":25,"bottom":25,"left":25,"right":25},"numbers":{"on":true,"pos":"bas-centre","format":"1","from":1,"first":1,"font":"","size":10,"color":"","bold":false,"italic":false,"box":"aucun","skip":{}},"header":{"on":true,"html":""},"footer":{"on":true,"html":""},"firstDifferent":false,"keep":true,"tagsAfterCover":true,"custom":false}},"content":{"html":"<h1 class=\"ft-title\">Calendrier des semis</h1><p>Repères pour la saison 2026 au jardin, sous un climat tempéré. Les variétés sont décrites dans le <a class=\"ft-doclink\" contenteditable=\"false\" data-doc=\"3c124e80-6d59-4a63-abc3-d70bc4c6b255\" title=\"Lien vers « Catalogue des tomates » (double-clic : ouvrir ; clic droit : autres choix)\">catalogue</a>.</p><h2>Du semis à la récolte</h2><span class=\"ft-image ft-diagram\" contenteditable=\"false\" data-diagram=\"{&quot;v&quot;:1,&quot;background&quot;:&quot;#ffffff&quot;,&quot;nodes&quot;:[{&quot;shape&quot;:&quot;ellipse&quot;,&quot;w&quot;:110,&quot;h&quot;:56,&quot;text&quot;:&quot;Semis&quot;,&quot;fill&quot;:&quot;#fde2e1&quot;,&quot;stroke&quot;:&quot;#c8402c&quot;,&quot;strokeWidth&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;shadow&quot;:false,&quot;opacity&quot;:1,&quot;font&quot;:&quot;Segoe UI&quot;,&quot;fontSize&quot;:14,&quot;bold&quot;:false,&quot;italic&quot;:false,&quot;textColor&quot;:&quot;#78281f&quot;,&quot;align&quot;:&quot;center&quot;,&quot;id&quot;:&quot;a&quot;,&quot;x&quot;:0,&quot;y&quot;:0},{&quot;shape&quot;:&quot;arrondi&quot;,&quot;w&quot;:120,&quot;h&quot;:56,&quot;text&quot;:&quot;Repiquage&quot;,&quot;fill&quot;:&quot;#fde2e1&quot;,&quot;stroke&quot;:&quot;#c8402c&quot;,&quot;strokeWidth&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;shadow&quot;:false,&quot;opacity&quot;:1,&quot;font&quot;:&quot;Segoe UI&quot;,&quot;fontSize&quot;:14,&quot;bold&quot;:false,&quot;italic&quot;:false,&quot;textColor&quot;:&quot;#78281f&quot;,&quot;align&quot;:&quot;center&quot;,&quot;id&quot;:&quot;b&quot;,&quot;x&quot;:150,&quot;y&quot;:0},{&quot;shape&quot;:&quot;arrondi&quot;,&quot;w&quot;:120,&quot;h&quot;:56,&quot;text&quot;:&quot;Plantation&quot;,&quot;fill&quot;:&quot;#fde2e1&quot;,&quot;stroke&quot;:&quot;#c8402c&quot;,&quot;strokeWidth&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;shadow&quot;:false,&quot;opacity&quot;:1,&quot;font&quot;:&quot;Segoe UI&quot;,&quot;fontSize&quot;:14,&quot;bold&quot;:false,&quot;italic&quot;:false,&quot;textColor&quot;:&quot;#78281f&quot;,&quot;align&quot;:&quot;center&quot;,&quot;id&quot;:&quot;c&quot;,&quot;x&quot;:310,&quot;y&quot;:0},{&quot;shape&quot;:&quot;arrondi&quot;,&quot;w&quot;:110,&quot;h&quot;:56,&quot;text&quot;:&quot;Récolte&quot;,&quot;fill&quot;:&quot;#d5f5e3&quot;,&quot;stroke&quot;:&quot;#27ae60&quot;,&quot;strokeWidth&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;shadow&quot;:false,&quot;opacity&quot;:1,&quot;font&quot;:&quot;Segoe UI&quot;,&quot;fontSize&quot;:14,&quot;bold&quot;:true,&quot;italic&quot;:false,&quot;textColor&quot;:&quot;#145a32&quot;,&quot;align&quot;:&quot;center&quot;,&quot;id&quot;:&quot;d&quot;,&quot;x&quot;:470,&quot;y&quot;:0},{&quot;shape&quot;:&quot;note&quot;,&quot;w&quot;:110,&quot;h&quot;:56,&quot;text&quot;:&quot;Graines&quot;,&quot;fill&quot;:&quot;#fcf3cf&quot;,&quot;stroke&quot;:&quot;#d4ac0d&quot;,&quot;strokeWidth&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;shadow&quot;:false,&quot;opacity&quot;:1,&quot;font&quot;:&quot;Segoe UI&quot;,&quot;fontSize&quot;:14,&quot;bold&quot;:false,&quot;italic&quot;:false,&quot;textColor&quot;:&quot;#7d6608&quot;,&quot;align&quot;:&quot;center&quot;,&quot;id&quot;:&quot;e&quot;,&quot;x&quot;:470,&quot;y&quot;:110}],&quot;links&quot;:[{&quot;route&quot;:&quot;coude&quot;,&quot;color&quot;:&quot;#8c7b70&quot;,&quot;width&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;start&quot;:&quot;&quot;,&quot;end&quot;:&quot;pleine&quot;,&quot;label&quot;:&quot;&quot;,&quot;id&quot;:&quot;l1&quot;,&quot;from&quot;:{&quot;node&quot;:&quot;a&quot;,&quot;side&quot;:&quot;e&quot;},&quot;to&quot;:{&quot;node&quot;:&quot;b&quot;,&quot;side&quot;:&quot;w&quot;}},{&quot;route&quot;:&quot;coude&quot;,&quot;color&quot;:&quot;#8c7b70&quot;,&quot;width&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;start&quot;:&quot;&quot;,&quot;end&quot;:&quot;pleine&quot;,&quot;label&quot;:&quot;&quot;,&quot;id&quot;:&quot;l2&quot;,&quot;from&quot;:{&quot;node&quot;:&quot;b&quot;,&quot;side&quot;:&quot;e&quot;},&quot;to&quot;:{&quot;node&quot;:&quot;c&quot;,&quot;side&quot;:&quot;w&quot;}},{&quot;route&quot;:&quot;coude&quot;,&quot;color&quot;:&quot;#8c7b70&quot;,&quot;width&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;start&quot;:&quot;&quot;,&quot;end&quot;:&quot;pleine&quot;,&quot;label&quot;:&quot;&quot;,&quot;id&quot;:&quot;l3&quot;,&quot;from&quot;:{&quot;node&quot;:&quot;c&quot;,&quot;side&quot;:&quot;e&quot;},&quot;to&quot;:{&quot;node&quot;:&quot;d&quot;,&quot;side&quot;:&quot;w&quot;}},{&quot;route&quot;:&quot;coude&quot;,&quot;color&quot;:&quot;#8c7b70&quot;,&quot;width&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;start&quot;:&quot;&quot;,&quot;end&quot;:&quot;pleine&quot;,&quot;label&quot;:&quot;&quot;,&quot;id&quot;:&quot;l4&quot;,&quot;from&quot;:{&quot;node&quot;:&quot;d&quot;,&quot;side&quot;:&quot;s&quot;},&quot;to&quot;:{&quot;node&quot;:&quot;e&quot;,&quot;side&quot;:&quot;n&quot;}},{&quot;route&quot;:&quot;coude&quot;,&quot;color&quot;:&quot;#8c7b70&quot;,&quot;width&quot;:1.5,&quot;dash&quot;:&quot;tirets&quot;,&quot;start&quot;:&quot;&quot;,&quot;end&quot;:&quot;pleine&quot;,&quot;label&quot;:&quot;l’année suivante&quot;,&quot;id&quot;:&quot;l5&quot;,&quot;from&quot;:{&quot;node&quot;:&quot;e&quot;,&quot;side&quot;:&quot;w&quot;},&quot;to&quot;:{&quot;node&quot;:&quot;a&quot;,&quot;side&quot;:&quot;s&quot;}}]}\" data-num=\"schema\" style=\"width: 96%;\"><img src=\"data:image/svg+xml;base64,\" alt=\"\" draggable=\"false\"><span class=\"ft-caption\" contenteditable=\"true\" data-cap=\"Schéma 1\">Le cycle des tomates au jardin</span></span><h2>Mois par mois</h2><p class=\"ft-legend\" data-kind=\"tableau\" data-cap=\"Tableau 1\">Calendrier de culture des tomates</p><table class=\"ft-table\" data-t=\"2\" data-style=\"raye\" data-color=\"orange\" data-header=\"oui\" data-bands=\"oui\" data-first=\"oui\" data-sep=\"oui\"><tbody><tr><td>Étape</td><td>Mars</td><td>Avril</td><td>Mai</td><td>Juin</td><td>Juillet</td><td>Août</td><td>Sept.</td></tr><tr><td>Semis au chaud</td><td>●</td><td>●</td><td></td><td></td><td></td><td></td><td></td></tr><tr><td>Repiquage</td><td></td><td>●</td><td>●</td><td></td><td></td><td></td><td></td></tr><tr><td>Plantation</td><td></td><td></td><td>●</td><td>●</td><td></td><td></td><td></td></tr><tr><td>Paillage</td><td></td><td></td><td></td><td>●</td><td>●</td><td></td><td></td></tr><tr><td>Récolte</td><td></td><td></td><td></td><td></td><td>●</td><td>●</td><td>●</td></tr><tr><td>Graines</td><td></td><td></td><td></td><td></td><td></td><td>●</td><td>●</td></tr></tbody></table><blockquote class=\"ft-callout\" data-look=\"bandeau\" data-color=\"ambre\"><p><b>Attention.</b> Ne pas planter en pleine terre avant les saints de glace (11, 12 et 13 mai) : une gelée tardive suffit à perdre les jeunes plants.</p></blockquote><h2>Dates de la saison 2026</h2><ul><li>Semis collectif : samedi 7 mars 2026, à la serre.</li><li>Repiquage en godets : samedi 11 avril 2026.</li><li>Plantation au jardin : samedi 16 mai 2026.</li><li>Fête des récoltes : dimanche 20 septembre 2026.</li></ul><p>Pendant l’été, l’arrosage suit la <a class=\"ft-doclink\" contenteditable=\"false\" data-doc=\"c16aab0b-7bd0-488f-a90a-548fa691e914\" title=\"Lien vers « Fiche – Arrosage et paillage » (double-clic : ouvrir ; clic droit : autres choix)\">fiche technique</a>.</p>"},"tags":[{"name":"Calendrier","color":"orange"},{"name":"Tomates","color":"rouge"}],"links":[],"meta":{}}