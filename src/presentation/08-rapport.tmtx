{"format":"frame-text","version":1,"id":"19f060aa-3315-4e06-a44c-27e933fa45ef","title":"Rapport d’activité 2026","created":"2026-10-20T08:00:00.000Z","modified":"2026-10-20T08:00:00.000Z","settings":{"autoIndent":false,"titleInText":true,"mode":"avance","index":[{"term":"atelier","variants":["ateliers"],"parent":""},{"term":"compostage","variants":[],"parent":""},{"term":"Green Zebra","variants":[],"parent":""},{"term":"Noire de Crimée","variants":[],"parent":""},{"term":"récolte","variants":["récoltes"],"parent":""},{"term":"serre","variants":[],"parent":""}],"comments":[{"id":"c1","author":"Julien Roche","date":"2026-10-18T09:20:00.000Z","text":"Le devis de la serre est arrivé : 2 400 €. À présenter avec le budget 2027.","done":false,"replies":[{"author":"Claire Martin","date":"2026-10-18T17:05:00.000Z","text":"Merci, je l’ajoute à l’ordre du jour."}]}],"columns":{"count":1,"rule":false},"theme":{"v":1,"id":"carmin","name":"Carmin","note":"Archivo et Source Serif, rouge carmin, filets éditoriaux, alinéas.","modified":false,"text":{"font":"Source Serif 4","size":10.5,"line":1.45,"space":0,"align":"justify","indent":"alinea"},"accent":"#af1d26","styles":{"title":{"font":"Archivo","size":26,"bold":true,"italic":false,"underline":false,"caps":false,"smallcaps":false,"color":"#7e1119","align":"","rule":false,"number":""},"headings":[{"font":"Archivo","size":15,"bold":true,"italic":false,"underline":false,"caps":false,"smallcaps":false,"color":"#26292e","align":"","rule":false,"number":""},{"font":"Archivo","size":11.5,"bold":true,"italic":false,"underline":false,"caps":false,"smallcaps":false,"color":"#7e1119","align":"","rule":false,"number":""},{"font":"Archivo","size":9,"bold":true,"italic":false,"underline":false,"caps":true,"smallcaps":false,"color":"#7e1119","align":"","rule":false,"number":""},{"font":"Source Serif 4","size":11.5,"bold":false,"italic":true,"underline":false,"caps":false,"smallcaps":false,"color":"#7e1119","align":"","rule":false,"number":""},{"font":"Source Serif 4","size":10.5,"bold":false,"italic":true,"underline":false,"caps":false,"smallcaps":false,"color":"","align":"","rule":false,"number":""}],"bullets":[{"symbol":"—","color":"#af1d26"},{"symbol":"–","color":""},{"symbol":"·","color":""},{"symbol":"–","color":""},{"symbol":"·","color":""}]},"table":{"style":"edition","color":"theme","header":true,"first":false,"total":false,"last":false,"bands":false,"bandcols":false,"sep":false,"font":"Archivo","size":9.5,"pad":""},"callout":{"look":"bande","color":""},"quote":{"look":"detachee","color":""},"toc":{"title":"Sommaire","showTitle":true,"titleStyle":"gras","titleAlign":"gauche","docTitle":false,"levels":5,"font":"Archivo","size":0,"color":"#7e1119","frame":"aucun","number":"I","leaders":true,"indent":true,"preset":"carmin"},"diagram":{"fill":"#f7e6e4","stroke":"#af1d26","textColor":"#7e1119","link":"#af1d26","font":"Arial","strokeWidth":1.5,"shadow":false,"palette":false},"margins":{"top":22,"bottom":20,"left":22,"right":17}},"pages":{"size":"A4","w":210,"h":297,"orient":"portrait","turned":{},"margins":{"top":22,"bottom":20,"left":22,"right":17},"numbers":{"on":true,"pos":"bas-centre","format":"1","from":1,"first":1,"font":"","size":10,"color":"","bold":false,"italic":false,"box":"aucun","skip":{}},"header":{"on":true,"html":""},"footer":{"on":true,"html":""},"firstDifferent":false,"keep":true,"tagsAfterCover":true,"custom":true}},"content":{"html":"<div class=\"ft-cover\" contenteditable=\"false\" data-model=\"botanique\"><div class=\"ft-cover-head\"><p class=\"ft-cover-field\" data-field=\"surtitre\" data-ph=\"Organisme ou établissement\" contenteditable=\"true\">Association Le Jardin des Quatre Saisons</p></div><div class=\"ft-cover-main\"><p class=\"ft-cover-field\" data-field=\"titre\" data-ph=\"Titre\" contenteditable=\"true\">Rapport d’activité 2026</p><p class=\"ft-cover-field\" data-field=\"soustitre\" data-ph=\"Sous-titre\" contenteditable=\"true\">Une saison au jardin</p></div><div class=\"ft-cover-foot\"><p class=\"ft-cover-field\" data-field=\"auteur\" data-ph=\"Auteur\" contenteditable=\"true\">Claire Martin et Amina Benali</p><p class=\"ft-cover-field\" data-field=\"date\" data-ph=\"Date\" contenteditable=\"true\">Octobre 2026</p><p class=\"ft-cover-field\" data-field=\"mention\" data-ph=\"Mention (type de document, version)\" contenteditable=\"true\">Document présenté à l’assemblée générale</p></div></div><div class=\"ft-toc\" contenteditable=\"false\" data-toc=\"{&quot;title&quot;:&quot;Sommaire&quot;,&quot;titleStyle&quot;:&quot;gras&quot;,&quot;docTitle&quot;:false,&quot;font&quot;:&quot;Archivo&quot;,&quot;color&quot;:&quot;#7e1119&quot;,&quot;frame&quot;:&quot;aucun&quot;,&quot;number&quot;:&quot;I&quot;,&quot;preset&quot;:&quot;carmin&quot;}\" data-frame=\"aucun\" data-tstyle=\"gras\" data-talign=\"gauche\" style=\"font-family: Archivo, Georgia, serif; --toc-color: #7e1119;\"><div class=\"ft-toc-label\">Sommaire</div><div class=\"ft-toc-item\" data-level=\"2\" data-target=\"0\"><span class=\"ft-toc-text\">A. Introduction</span><span class=\"ft-toc-page\">2</span></div><div class=\"ft-toc-item\" data-level=\"2\" data-target=\"1\"><span class=\"ft-toc-text\">B. Organisation</span><span class=\"ft-toc-page\">2</span></div><div class=\"ft-toc-item\" data-level=\"2\" data-target=\"2\"><span class=\"ft-toc-text\">C. Les cultures</span><span class=\"ft-toc-page\">2</span></div><div class=\"ft-toc-item\" data-level=\"3\" data-target=\"3\"><span class=\"ft-toc-text\">1. Les récoltes</span><span class=\"ft-toc-page\">2</span></div><div class=\"ft-toc-item\" data-level=\"3\" data-target=\"4\"><span class=\"ft-toc-text\">2. Les variétés</span><span class=\"ft-toc-page\">3</span></div><div class=\"ft-toc-item\" data-level=\"2\" data-target=\"5\"><span class=\"ft-toc-text\">D. Les ateliers</span><span class=\"ft-toc-page\">3</span></div><div class=\"ft-toc-item\" data-level=\"2\" data-target=\"6\"><span class=\"ft-toc-text\">E. Perspectives</span><span class=\"ft-toc-page\">3</span></div></div><h2 data-xid=\"intro\">Introduction</h2><p>L’année 2026 a été celle de la consolidation. Le nombre d’adhérents est passé de 52 à 64, les récoltes ont atteint 641&nbsp;kg, et les ateliers ont accueilli plus de 300&nbsp;participants. Ce rapport présente le bilan de la saison, adopté en partie lors de l’<a class=\"ft-doclink\" contenteditable=\"false\" data-doc=\"f6dc14e7-ab0c-4694-a244-928a5320d232\" title=\"Lien vers « Assemblée générale du 14 mars 2026 » (double-clic : ouvrir ; clic droit : autres choix)\">assemblée générale du 14 mars 2026</a>.</p><h2 data-xid=\"orga\">Organisation</h2><p>L’association est administrée par un bureau de quatre membres, élu chaque année ; son fonctionnement est rappelé dans la <a class=\"ft-doclink\" contenteditable=\"false\" data-doc=\"c4b5f64b-eeca-43c4-ac9d-6622856ce18b\" title=\"Lien vers « Présentation de l’association » (double-clic : ouvrir ; clic droit : autres choix)\">présentation de l’association</a> et résumé par le <span class=\"ft-xref\" contenteditable=\"false\" data-target=\"x:org\" data-show=\"label\" title=\"Renvoi vers schéma : Organisation de l’association (Ctrl+clic : y aller ; double-clic : modifier)\">schéma 1</span> ci-dessous.</p><span class=\"ft-image ft-diagram\" contenteditable=\"false\" data-diagram=\"{&quot;v&quot;:1,&quot;background&quot;:&quot;#ffffff&quot;,&quot;nodes&quot;:[{&quot;shape&quot;:&quot;arrondi&quot;,&quot;w&quot;:180,&quot;h&quot;:56,&quot;text&quot;:&quot;Assemblée générale&quot;,&quot;fill&quot;:&quot;#fde2e1&quot;,&quot;stroke&quot;:&quot;#c8402c&quot;,&quot;strokeWidth&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;shadow&quot;:false,&quot;opacity&quot;:1,&quot;font&quot;:&quot;Segoe UI&quot;,&quot;fontSize&quot;:14,&quot;bold&quot;:true,&quot;italic&quot;:false,&quot;textColor&quot;:&quot;#78281f&quot;,&quot;align&quot;:&quot;center&quot;,&quot;id&quot;:&quot;ag&quot;,&quot;x&quot;:170,&quot;y&quot;:0},{&quot;shape&quot;:&quot;arrondi&quot;,&quot;w&quot;:180,&quot;h&quot;:56,&quot;text&quot;:&quot;Bureau (4 membres)&quot;,&quot;fill&quot;:&quot;#d5f5e3&quot;,&quot;stroke&quot;:&quot;#27ae60&quot;,&quot;strokeWidth&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;shadow&quot;:false,&quot;opacity&quot;:1,&quot;font&quot;:&quot;Segoe UI&quot;,&quot;fontSize&quot;:14,&quot;bold&quot;:false,&quot;italic&quot;:false,&quot;textColor&quot;:&quot;#145a32&quot;,&quot;align&quot;:&quot;center&quot;,&quot;id&quot;:&quot;bu&quot;,&quot;x&quot;:170,&quot;y&quot;:100},{&quot;shape&quot;:&quot;rect&quot;,&quot;w&quot;:140,&quot;h&quot;:56,&quot;text&quot;:&quot;Cultures&quot;,&quot;fill&quot;:&quot;#ffffff&quot;,&quot;stroke&quot;:&quot;#c8402c&quot;,&quot;strokeWidth&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;shadow&quot;:false,&quot;opacity&quot;:1,&quot;font&quot;:&quot;Segoe UI&quot;,&quot;fontSize&quot;:14,&quot;bold&quot;:false,&quot;italic&quot;:false,&quot;textColor&quot;:&quot;#78281f&quot;,&quot;align&quot;:&quot;center&quot;,&quot;id&quot;:&quot;c1&quot;,&quot;x&quot;:0,&quot;y&quot;:210},{&quot;shape&quot;:&quot;rect&quot;,&quot;w&quot;:140,&quot;h&quot;:56,&quot;text&quot;:&quot;Ateliers&quot;,&quot;fill&quot;:&quot;#ffffff&quot;,&quot;stroke&quot;:&quot;#c8402c&quot;,&quot;strokeWidth&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;shadow&quot;:false,&quot;opacity&quot;:1,&quot;font&quot;:&quot;Segoe UI&quot;,&quot;fontSize&quot;:14,&quot;bold&quot;:false,&quot;italic&quot;:false,&quot;textColor&quot;:&quot;#78281f&quot;,&quot;align&quot;:&quot;center&quot;,&quot;id&quot;:&quot;c2&quot;,&quot;x&quot;:190,&quot;y&quot;:210},{&quot;shape&quot;:&quot;rect&quot;,&quot;w&quot;:140,&quot;h&quot;:56,&quot;text&quot;:&quot;Cuisine et partage&quot;,&quot;fill&quot;:&quot;#ffffff&quot;,&quot;stroke&quot;:&quot;#c8402c&quot;,&quot;strokeWidth&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;shadow&quot;:false,&quot;opacity&quot;:1,&quot;font&quot;:&quot;Segoe UI&quot;,&quot;fontSize&quot;:14,&quot;bold&quot;:false,&quot;italic&quot;:false,&quot;textColor&quot;:&quot;#78281f&quot;,&quot;align&quot;:&quot;center&quot;,&quot;id&quot;:&quot;c3&quot;,&quot;x&quot;:380,&quot;y&quot;:210}],&quot;links&quot;:[{&quot;route&quot;:&quot;coude&quot;,&quot;color&quot;:&quot;#8c7b70&quot;,&quot;width&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;start&quot;:&quot;&quot;,&quot;end&quot;:&quot;pleine&quot;,&quot;label&quot;:&quot;élit&quot;,&quot;id&quot;:&quot;l1&quot;,&quot;from&quot;:{&quot;node&quot;:&quot;ag&quot;,&quot;side&quot;:&quot;s&quot;},&quot;to&quot;:{&quot;node&quot;:&quot;bu&quot;,&quot;side&quot;:&quot;n&quot;}},{&quot;route&quot;:&quot;coude&quot;,&quot;color&quot;:&quot;#8c7b70&quot;,&quot;width&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;start&quot;:&quot;&quot;,&quot;end&quot;:&quot;pleine&quot;,&quot;label&quot;:&quot;&quot;,&quot;id&quot;:&quot;l2&quot;,&quot;from&quot;:{&quot;node&quot;:&quot;bu&quot;,&quot;side&quot;:&quot;s&quot;},&quot;to&quot;:{&quot;node&quot;:&quot;c1&quot;,&quot;side&quot;:&quot;n&quot;}},{&quot;route&quot;:&quot;coude&quot;,&quot;color&quot;:&quot;#8c7b70&quot;,&quot;width&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;start&quot;:&quot;&quot;,&quot;end&quot;:&quot;pleine&quot;,&quot;label&quot;:&quot;&quot;,&quot;id&quot;:&quot;l3&quot;,&quot;from&quot;:{&quot;node&quot;:&quot;bu&quot;,&quot;side&quot;:&quot;s&quot;},&quot;to&quot;:{&quot;node&quot;:&quot;c2&quot;,&quot;side&quot;:&quot;n&quot;}},{&quot;route&quot;:&quot;coude&quot;,&quot;color&quot;:&quot;#8c7b70&quot;,&quot;width&quot;:1.5,&quot;dash&quot;:&quot;&quot;,&quot;start&quot;:&quot;&quot;,&quot;end&quot;:&quot;pleine&quot;,&quot;label&quot;:&quot;&quot;,&quot;id&quot;:&quot;l4&quot;,&quot;from&quot;:{&quot;node&quot;:&quot;bu&quot;,&quot;side&quot;:&quot;s&quot;},&quot;to&quot;:{&quot;node&quot;:&quot;c3&quot;,&quot;side&quot;:&quot;n&quot;}}]}\" data-num=\"schema\" data-xid=\"org\" style=\"width: 88%;\"><img src=\"data:image/svg+xml;base64,\" alt=\"\" draggable=\"false\"><span class=\"ft-caption\" contenteditable=\"true\" data-cap=\"Schéma 1\">Organisation de l’association</span></span><h2 data-xid=\"cultures\">Les cultures</h2><h3>Les récoltes</h3><p>Les récoltes de tomates ont atteint leur maximum en août, avec 236&nbsp;kg (voir la <span class=\"ft-xref\" contenteditable=\"false\" data-target=\"x:fig-recoltes\" data-show=\"label\" title=\"Renvoi vers figure : Récoltes de tomates par mois (kg) (Ctrl+clic : y aller ; double-clic : modifier)\">figure 1</span>). Les variétés anciennes du <a class=\"ft-doclink\" contenteditable=\"false\" data-doc=\"3c124e80-6d59-4a63-abc3-d70bc4c6b255\" title=\"Lien vers « Catalogue des tomates » (double-clic : ouvrir ; clic droit : autres choix)\">catalogue</a> ont toutes bien donné, malgré un mois de juin pluvieux<sup class=\"ft-fn-ref\" data-fn=\"n1\" contenteditable=\"false\">1</sup>.</p><span class=\"ft-image\" data-num=\"figure\" data-xid=\"fig-recoltes\" contenteditable=\"false\" style=\"width: 80%\"><img src=\"data:image/svg+xml;base64,\" alt=\"\" draggable=\"false\"><span class=\"ft-caption\" contenteditable=\"true\" data-cap=\"Figure 1\">Récoltes de tomates par mois (kg)</span></span><h3>Les variétés</h3><p>Le <span class=\"ft-xref\" contenteditable=\"false\" data-target=\"x:tab-varietes\" data-show=\"label\" title=\"Renvoi vers tableau : Rendements par variété (Ctrl+clic : y aller ; double-clic : modifier)\">tableau 1</span> détaille les rendements par variété. La Noire de Crimée confirme sa première place ; la Green Zebra, testée cette année, sera reconduite.</p><p class=\"ft-legend\" data-kind=\"tableau\" data-xid=\"tab-varietes\" data-cap=\"Tableau 1\">Rendements par variété</p><table class=\"ft-table\" data-t=\"2\" data-style=\"liste\" data-color=\"theme\" data-header=\"oui\" data-font=\"Archivo\" data-fsize=\"9.5\" style=\"font-family: Archivo, Georgia, serif; font-size: 9.5pt;\" data-first=\"oui\" data-total=\"oui\" data-sep=\"oui\"><tbody><tr><td>Variété</td><td>Pieds</td><td>Récolte</td><td>Par pied</td></tr><tr><td>Cœur de bœuf</td><td>24</td><td>168&nbsp;kg</td><td>7,0&nbsp;kg</td></tr><tr><td>Noire de Crimée</td><td>20</td><td>172&nbsp;kg</td><td>8,6&nbsp;kg</td></tr><tr><td>Green Zebra</td><td>12</td><td>71&nbsp;kg</td><td>5,9&nbsp;kg</td></tr><tr><td>Cerise rouge</td><td>30</td><td>230&nbsp;kg</td><td>7,7&nbsp;kg</td></tr><tr><td>Total</td><td>86</td><td>641&nbsp;kg</td><td>7,5&nbsp;kg</td></tr></tbody></table><h2 data-xid=\"ateliers\">Les ateliers</h2><p>Douze ateliers ont eu lieu, dont quatre avec les écoles du quartier. Le compostage et la récolte des graines restent les plus demandés. La journée de cuisine du 10 octobre 2026 a produit 180 bocaux de coulis, selon les <a class=\"ft-doclink\" contenteditable=\"false\" data-doc=\"32742404-6bba-48e5-ac93-866117a2842f\" title=\"Lien vers « Recettes de saison » (double-clic : ouvrir ; clic droit : autres choix)\">recettes de saison</a>.</p><ul><li>Semis et repiquage : 3&nbsp;ateliers, 74&nbsp;participants ;</li><li>Compostage : 3&nbsp;ateliers, 61&nbsp;participants ;</li><li>Récolte des graines : 2&nbsp;ateliers, 48&nbsp;participants ;</li><li>Ateliers scolaires : 4 séances, 120&nbsp;élèves.</li></ul><blockquote class=\"ft-callout ft-quote\"><p>Les enfants repartent avec un plant de tomate dans un pot de yaourt. En septembre, certains reviennent nous montrer leurs récoltes.</p><p class=\"ft-quote-src\">Paul Girard, référent cultures</p></blockquote><h2 data-xid=\"perspectives\">Perspectives</h2><p>Pour 2027, le bureau propose d’agrandir la serre, de créer une grainothèque ouverte au quartier, et de publier ce catalogue de variétés. <span class=\"ft-comment\" data-c=\"c1\">Le budget de ces projets reste à confirmer</span> lors de la prochaine assemblée générale.</p><div class=\"ft-lof\" contenteditable=\"false\" data-kind=\"tout\"><div class=\"ft-lof-label\">Table des illustrations</div><div class=\"ft-lof-item\" data-target=\"0\"><span class=\"ft-lof-text\">Schéma 1&nbsp;: Organisation de l’association</span><span class=\"ft-lof-page\">2</span></div><div class=\"ft-lof-item\" data-target=\"1\"><span class=\"ft-lof-text\">Figure 1&nbsp;: Récoltes de tomates par mois (kg)</span><span class=\"ft-lof-page\">3</span></div><div class=\"ft-lof-item\" data-target=\"2\"><span class=\"ft-lof-text\">Tableau 1&nbsp;: Rendements par variété</span><span class=\"ft-lof-page\">3</span></div></div><div class=\"ft-index\" contenteditable=\"false\"><div class=\"ft-index-label\">Index</div><div class=\"ft-index-letter\">A</div><div class=\"ft-index-entry\" data-term=\"atelier\"><span class=\"ft-index-term\">atelier</span><span class=\"ft-index-pages\">, 2, 3</span></div><div class=\"ft-index-letter\">C</div><div class=\"ft-index-entry\" data-term=\"compostage\"><span class=\"ft-index-term\">compostage</span><span class=\"ft-index-pages\">, 3</span></div><div class=\"ft-index-letter\">G</div><div class=\"ft-index-entry\" data-term=\"Green Zebra\"><span class=\"ft-index-term\">Green Zebra</span><span class=\"ft-index-pages\">, 3</span></div><div class=\"ft-index-letter\">N</div><div class=\"ft-index-entry\" data-term=\"Noire de Crimée\"><span class=\"ft-index-term\">Noire de Crimée</span><span class=\"ft-index-pages\">, 3</span></div><div class=\"ft-index-letter\">R</div><div class=\"ft-index-entry\" data-term=\"récolte\"><span class=\"ft-index-term\">récolte</span><span class=\"ft-index-pages\">, 2, 3</span></div><div class=\"ft-index-letter\">S</div><div class=\"ft-index-entry\" data-term=\"serre\"><span class=\"ft-index-term\">serre</span><span class=\"ft-index-pages\">, 3</span></div></div><div class=\"ft-footnotes\"><ol><li data-fn=\"n1\">Météo-France : 112&nbsp;mm de pluie en juin 2026, contre 68&nbsp;mm en moyenne.</li></ol></div>"},"tags":[{"name":"Rapport","color":"jaune"},{"name":"2026","color":"jaune"},{"name":"Association","color":"vert"}],"links":[],"meta":{}}